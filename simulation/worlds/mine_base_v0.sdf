<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="mine_base">

    <!-- ===================================================== -->
    <!-- PHYSICS                                               -->
    <!-- ===================================================== -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ===================================================== -->
    <!-- LIGHTING                                              -->
    <!-- ===================================================== -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>


    <!-- ===================================================== -->
    <!-- GROUND                                                -->
    <!-- ===================================================== -->

    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- MINE BENCH 1                                          -->
    <!-- ===================================================== -->

    <model name="mine_bench_1">
      <static>true</static>
      <pose>0 15 2 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- MINE BENCH 2                                          -->
    <!-- ===================================================== -->

    <model name="mine_bench_2">
      <static>true</static>
      <pose>0 35 6 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- MINE BENCH 3                                          -->
    <!-- ===================================================== -->

    <model name="mine_bench_3">
      <static>true</static>
      <pose>0 55 10 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>80 20 4</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- MAIN HAUL ROAD                                        -->
    <!-- ===================================================== -->

    <model name="main_haul_road">
      <static>true</static>
      <pose>0 -5 0.15 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>12 70 0.3</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12 70 0.3</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- HAUL ROAD RAMP                                        -->
    <!-- ===================================================== -->

    <model name="haul_road_ramp">
      <static>true</static>

      <pose>25 35 6 0 0.30 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>12 45 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12 45 1</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- LOADING AREA                                          -->
    <!-- ===================================================== -->

    <model name="loading_area">
      <static>true</static>
      <pose>-20 -25 0.2 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 25 0.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 25 0.4</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- DUMPING AREA                                          -->
    <!-- ===================================================== -->

    <model name="dumping_area">
      <static>true</static>
      <pose>20 45 0.2 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 25 0.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 25 0.4</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


  </world>

</sdf>
